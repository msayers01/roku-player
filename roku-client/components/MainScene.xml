<?xml version="1.0" encoding="utf-8" ?>
<!--
    The single SceneGraph Scene. The design's ConnectionScene / PosterGridScene /
    DetailsScene / PlaybackScene are Group "screens" stacked inside it, because a
    channel can only show one Scene at a time.
-->
<component name="MainScene" extends="Scene">
    <interface>
        <field id="exitApp" type="boolean" value="false" />
    </interface>
    <script type="text/brightscript" uri="MainScene.brs" />
    <script type="text/brightscript" uri="pkg:/components/common/Utils.brs" />
    <children>
        <Rectangle id="background" width="1920" height="1080" color="0x0E1116FF" />
        <Group id="screens" />
    </children>
</component>
