<?xml version="1.0" encoding="utf-8" ?>
<!-- One-shot HTTP GET of a JSON API endpoint, off the render thread. -->
<component name="CatalogTask" extends="Task">
    <interface>
        <field id="url" type="string" />
        <field id="timeoutMs" type="integer" value="8000" />
        <field id="response" type="assocarray" />
    </interface>
    <script type="text/brightscript" uri="CatalogTask.brs" />
</component>
